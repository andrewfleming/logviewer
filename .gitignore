node_modules/

# Secrets. `sf publish` reads .env.server and pushes each key into the space as
# a secret; the file itself must never be committed. .spacefast holds CLI state
# including tokens. This repo is public.
.env.server
.spacefast/
.spacefast/state.json
/.spacefast-*
.spacefast/.spacefast-*
.spacefast/.space-link-*.tmp

# Generated by `sf publish` (compiled worker bundle).
__spacefast/
